# Claude API key (only needed for /api/insights phrasing and /api/ask). Endpoints degrade gracefully without it.
ANTHROPIC_API_KEY=
# SQLite database (read-only at runtime). Rebuilt from data/processed/*.csv if missing.
DATABASE_PATH=data/india_tourism.db
# Comma-separated list of allowed front-end origins.
CORS_ORIGINS=http://localhost:5173
# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5-5
# PORT=8000
